<!DOCTYPE html>
<html lang="en">
<head>
	<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
	<title>Login - Aplikasi Penelitian Dosen</title>
    <link rel="icon" href="assets/images/icon.png" type="image/x-icon">
	<link rel="stylesheet" href="assets/styles/style.min.css">
	<link rel="stylesheet" href="assets/plugin/waves/waves.min.css">
</head>
<body>

	<div id="single-wrapper">
		<form id="loginForm" class="frm-single">
			<div class="inside">
				<div class="title"><strong>Aplikasi </strong>Penelitian Dosen</div>
				<div class="frm-title">Login</div>
				<div class="frm-input">
                    <input type="text" placeholder="Username / Dosen ID" class="frm-inp" id="username">
                    <i class="fa fa-user frm-ico"></i>
                </div>
				<div class="frm-input">
                    <input type="password" placeholder="Password" class="frm-inp" id="password">
                    <i class="fa fa-lock frm-ico"></i>
                </div>
				<button type="submit" id="login_btn" class="frm-submit">Login<i class="fa fa-arrow-circle-right"></i></button>
				<a href="index.html" class="a-link"><i class="fa fa-arrow-circle-right"></i>Kembali ke halaman utama.</a>
				<div class="frm-footer text-center" >Sistem Penelitian Dosen <br> Universitas Handayani Makassar. <br> Copyright &copy; 2026</div>
			</div>
		</form>
	</div>

	<script src="assets/scripts/jquery.min.js"></script>
	<script src="assets/scripts/modernizr.min.js"></script>
	<script src="assets/plugin/bootstrap/js/bootstrap.min.js"></script>
	<script src="assets/plugin/nprogress/nprogress.js"></script>
	<script src="assets/plugin/waves/waves.min.js"></script>
	<script src="assets/scripts/main.min.js"></script>

	<script>
		document.getElementById('loginForm').addEventListener('submit', async function (e) {
			e.preventDefault();

			const user = document.getElementById('username').value.trim();
			const pass = document.getElementById('password').value.trim();
            const btn = document.getElementById('login_btn');

            if (!user || !pass) {
                alert('Harap isi username dan password!');
                return;
            }

            // Show loading state
            const originalText = btn.innerHTML;
            btn.innerHTML = 'Loading... <i class="fa fa-spinner fa-spin"></i>';
            btn.disabled = true;

            try {
                // Send request to backend
                const response = await fetch('/api/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username: user, password: pass })
                });

                const data = await response.json();
                console.log('Login response:', data);

                if (response.ok && data.success) {
                    // Clear previous auth data
                    localStorage.clear();

                    if (data.role === 'admin') {
                        localStorage.setItem('admin_auth', 'true');
                        window.location.href = 'admin_index.html';
                    } else if (data.role === 'dosen') {
                        // Store dosen_id as the auth token for the dosen
                        localStorage.setItem('dosen_id', data.dosen_id);
                        localStorage.setItem('dosen_name', data.dosen_name);
                        window.location.href = 'dosen_index.html';
                    } else if (data.role === 'mahasiswa') {
                        localStorage.setItem('id_mahasiswa', data.id_mahasiswa);
                        localStorage.setItem('nama_mahasiswa', data.nama_mahasiswa);
                        window.location.href = 'mahasiswa_index.html';
                    } 
                } else {
                    alert(data.message || 'Login gagal!');
                    document.getElementById('password').value = '';
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Terjadi kesalahan pada server.');
            } finally {
                // Restore button state
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
		});
	</script>
</body>
</html>